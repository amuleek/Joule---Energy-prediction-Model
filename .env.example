# Email Configuration
SENDER_EMAIL=amuleeksidhu96@gmail.com
SENDER_PASSWORD=your-gmail-app-password
RECIPIENT_EMAILS=taransandhu@gillenergy.com,bikramgill@gillenergy.com,ravigill@gillenergy.com,kashmirgill@gillenergy.com

# Web dashboard (optional password for public internet)
DASHBOARD_PASSWORD=
DASHBOARD_USER=admin
DASHBOARD_PORT=8080

# API Keys (get your own â€” never commit real keys)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
EIA_API_KEY=your-eia-api-key
NEWS_API_KEY=your-newsapi-key
WORLD_NEWS_API_KEY=your-world-news-api-key
# Optional: Barchart OnDemand API (settlement prices; scrape works without a key)
BARCHART_API_KEY=

# Prediction Schedule (EST Timezone)
PREDICTION_TIMES=06:00,09:00,12:00,18:00
PREDICTION_TIMEZONE=US/Eastern
# Avoid duplicate email on scheduler restart
SCHEDULER_SEND_ON_STARTUP=false
# Skip repeat day-1 emails when direction/price unchanged between runs
DEDUPE_DAY1_EMAILS=true
DEDUPE_DAY1_PRICE_PCT=0.20
# Block duplicate email if same call sent within N minutes (scheduler + manual overlap)
DAY1_EMAIL_COOLDOWN_MINUTES=45

# NYMEX roll: use October RBOB (RB*2) in last 5 days of month — matches ~$3.11 screen
NYMEX_AUTO_ROLL_RBOB=true
NYMEX_AUTO_ROLL_ULSD=true
NYMEX_ROLL_DAYS_BEFORE_MONTH_END=5

# Pipeline speed (recommended defaults)
USE_FINBERT=false
NEWS_MAX_ARTICLES=150
NEWS_SENTIMENT_DAYS=7
RAG_SKIP_INDEX=true
CATBOOST_RETRAIN_EACH_RUN=false
# Set false for better day-1 direction (uses ML technical layer, slower)
FAST_ENSEMBLE=false

# Weekend day-1: defer Monday call until Asia/Globex tape is readable
DEFER_WEEKEND_DAY1_UNTIL_ASIA=true
ASIA_TAPE_READY_HOUR_ET=20
ASIA_TAPE_READY_MINUTE_ET=15
ASIA_TAPE_GAP_READY_PCT=1.0

# Intraday correction: flip morning day-1 when live tape gaps opposite
INTRADAY_CORRECTION_ENABLED=true
INTRADAY_TAPE_FLIP_PCT=2.0
INTRADAY_CHECK_TIMES=10:30,13:30
INTRADAY_WINDOW_START_HOUR_ET=8
INTRADAY_WINDOW_END_HOUR_ET=14
INTRADAY_WINDOW_END_MINUTE_ET=30
SKIP_XGB_IMPORTANCE=true
# Fraction of measured day-1 bias to apply after overlays (lower = keep more signal)
DAY1_BIAS_FACTOR=0.40
# Minimum fraction of day-1 signal to keep when bias correction would flatten it
DAY1_BIAS_RETAIN_FLOOR=0.70

# Optional: Alert Configuration
ENABLE_PRICE_ALERTS=false
PRICE_CHANGE_THRESHOLD=2.0
